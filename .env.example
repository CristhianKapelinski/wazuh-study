# Lab environment (local, not internet-exposed).
# Copy to .env and replace the placeholders before running ./run.sh.
WAZUH_VERSION=4.14.5

# Replace with strong, locally-generated values; do NOT commit .env
ADMIN_PASSWORD=__REPLACE_ME__
KIBANASERVER_PASSWORD=__REPLACE_ME__
API_PASSWORD=__REPLACE_ME__

# bcrypt hashes of the two passwords above (e.g. htpasswd -bnBC 12 "" <pw>)
ADMIN_HASH='__REPLACE_ME_BCRYPT__'
KIBANASERVER_HASH='__REPLACE_ME_BCRYPT__'

DASHBOARD_PORT=8444
COMPOSE_PROJECT_NAME=wazuhstudy

# Persistent bind mounts (any local path owned by you)
DATA_DIR=/var/lib/wazuh-study-data
