<group name="acme-lab,local,">

  <!-- ============================================================ -->
  <!-- SSH: geografia / origem da conexão                           -->
  <!-- ============================================================ -->

  <!-- Login SSH bem-sucedido vindo de FORA das faixas BR institucionais.
       Geografia eh o fator mais forte declarado pela equipe; um success
       fora das faixas legitimas representa impacto efetivo (sessao aberta),
       portanto critico. -->
  <rule id="100001" level="13">
    <if_sid>5715</if_sid>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <description>SSH: login bem-sucedido de origem fora das faixas BR institucionais (ACME-LAB)</description>
    <group>authentication_success,pci_dss_10.2.5,</group>
  </rule>

  <!-- Falha de autenticacao SSH vinda de FORA das faixas institucionais.
       Tentativa isolada (sem impacto efetivo) + origem anomala => medio. -->
  <rule id="100002" level="6">
    <if_sid>5716,5760</if_sid>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <description>SSH: falha de autenticacao de origem fora das faixas BR institucionais</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Tentativa de login com usuario inexistente vinda de fora das faixas
       institucionais: scan/enumeracao direcionada => medio. -->
  <rule id="100003" level="6">
    <if_sid>5710</if_sid>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <description>SSH: tentativa de login com usuario inexistente, origem fora do BR institucional</description>
    <group>invalid_login,</group>
  </rule>

  <!-- Login SSH bem-sucedido DENTRO das faixas institucionais: comportamento
       esperado; baixo apenas para rastreabilidade. Horario nao eleva. -->
  <rule id="100004" level="3">
    <if_sid>5715</if_sid>
    <srcip>203.0.113.0/24</srcip>
    <description>SSH: login bem-sucedido da rede institucional ACME-LAB</description>
    <group>authentication_success,</group>
  </rule>
  <rule id="100005" level="3">
    <if_sid>5715</if_sid>
    <srcip>203.0.113.0/24</srcip>
    <description>SSH: login bem-sucedido da rede institucional ACME-LAB</description>
    <group>authentication_success,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- SSH: correlacao por volume / repeticao da mesma origem        -->
  <!-- ============================================================ -->

  <!-- Brute force ja detectado pelo nativo (5712/5763) com origem fora do
       BR institucional: eleva para critico pois soma "volume da mesma
       origem" + "geografia anomala". -->
  <rule id="100010" level="13">
    <if_sid>5712,5763</if_sid>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <description>SSH: brute force a partir de IP fora das faixas BR institucionais</description>
    <group>authentication_failures,</group>
  </rule>

  <!-- Brute force "lento" da mesma origem externa: 8 falhas em 600s.
       Threshold mais baixo que o nativo (que exige rajada curta), para
       capturar atacantes que distribuem tentativas e escapam de 5712/5763.
       Janela ampla pois nao ha horario comercial a respeitar. -->
  <rule id="100011" level="10" frequency="8" timeframe="600">
    <if_matched_sid>100002</if_matched_sid>
    <same_srcip />
    <description>SSH: brute force lento (8 falhas/10min) da mesma origem externa</description>
    <group>authentication_failures,</group>
  </rule>

  <!-- Enumeracao de usuarios da mesma origem externa: 5 usuarios
       inexistentes diferentes em 600s sugere varredura de contas. -->
  <rule id="100012" level="10" frequency="5" timeframe="600">
    <if_matched_sid>100003</if_matched_sid>
    <same_srcip />
    <description>SSH: enumeracao de usuarios (5 invalidos/10min) da mesma origem externa</description>
    <group>invalid_login,</group>
  </rule>

  <!-- Sucesso SSH externo precedido por falhas da MESMA origem: indica
       que o brute force teve impacto efetivo (credencial valida obtida).
       Maximo da escala. -->
  <rule id="100013" level="15" frequency="2" timeframe="900">
    <if_matched_sid>100001</if_matched_sid>
    <same_srcip />
    <description>SSH: possivel comprometimento - login externo bem-sucedido apos falhas da mesma origem</description>
    <group>authentication_success,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- Escalada de privilegio                                        -->
  <!-- ============================================================ -->

  <!-- 3 falhas de sudo (5404) ja eh alto no nativo. Correlacao de
       multiplas ocorrencias do mesmo usuario em 10min sugere tentativa
       persistente de escalada => critico. -->
  <rule id="100020" level="13" frequency="2" timeframe="600">
    <if_matched_sid>5404</if_matched_sid>
    <same_user />
    <description>Escalada persistente: multiplas rajadas de falhas sudo do mesmo usuario</description>
    <group>privilege_escalation,</group>
  </rule>

  <!-- Primeiro uso de sudo (5403) por um usuario seguido de sucesso para
       root: comportamento novo de conta em servidor academico merece
       atencao adicional. -->
  <rule id="100021" level="8" frequency="2" timeframe="120">
    <if_matched_sid>5403</if_matched_sid>
    <same_user />
    <description>Usuario executando sudo pela primeira vez repetidamente em curto intervalo</description>
    <group>privilege_escalation,</group>
  </rule>

  <!-- su com senha errada para root (5302) repetido: tentativa de
       escalada por su, equivalente a brute force local. -->
  <rule id="100022" level="10" frequency="3" timeframe="300">
    <if_matched_sid>5302</if_matched_sid>
    <same_user />
    <description>Multiplas falhas de su para root pelo mesmo usuario</description>
    <group>privilege_escalation,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- Eventos de alto impacto efetivo                               -->
  <!-- ============================================================ -->

  <!-- Login direto como root via SSH (illegal root login - 2504) vindo
       de fora das faixas institucionais: impacto efetivo maximo. -->
  <rule id="100030" level="14">
    <if_sid>2504</if_sid>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <description>Login root ilegal a partir de origem fora das faixas BR institucionais</description>
    <group>authentication_success,</group>
  </rule>

  <!-- System user logado com sucesso (40101) vindo de fora do BR
       institucional: contas de sistema nao deveriam logar interativamente,
       muito menos de fora => critico. -->
  <rule id="100031" level="14">
    <if_sid>40101</if_sid>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <description>Conta de sistema logada com sucesso a partir de origem externa</description>
    <group>authentication_success,</group>
  </rule>

  <!-- PAM: multiplas falhas (5551) vindas de origem externa: medio-alto;
       eleva o nativo por geografia. -->
  <rule id="100032" level="12">
    <if_sid>5551</if_sid>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <srcip negate="yes">203.0.113.0/24</srcip>
    <description>PAM: multiplas falhas de login a partir de origem externa</description>
    <group>authentication_failures,</group>
  </rule>

</group>
