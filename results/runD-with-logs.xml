<group name="acme-lab,local,">

  <!-- ============================================================ -->
  <!-- SSH: acesso fora das faixas BR institucionais                 -->
  <!-- Geografia e o fator mais forte; qualquer evento sshd vindo de -->
  <!-- fora das duas faixas institucionais ja e anomalo.             -->
  <!-- ============================================================ -->

  <!-- Login SSH bem-sucedido fora das faixas institucionais.
       Impacto efetivo (sessao aberta) + origem nao-institucional =
       critico. Acesso legitimo so vem das faixas BR declaradas. -->
  <rule id="100001" level="14">
    <if_sid>5715</if_sid>
    <srcip negate="yes">203.0.113.0/24|203.0.113.0/24</srcip>
    <description>SSH: login bem-sucedido de IP fora das faixas institucionais ACME-LAB (impacto efetivo)</description>
    <group>authentication_success,intrusion,pci_dss_10.2.5,</group>
  </rule>

  <!-- Falha de autenticacao SSH originada de fora das faixas BR.
       Tentativa isolada ainda nao e impacto, mas a origem ja e
       anomala -> medio. -->
  <rule id="100002" level="6">
    <if_sid>5716,5760</if_sid>
    <srcip negate="yes">203.0.113.0/24|203.0.113.0/24</srcip>
    <description>SSH: falha de autenticacao de IP fora das faixas institucionais ACME-LAB</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Tentativa de login com usuario inexistente vinda de fora das
       faixas BR institucionais. Indica reconhecimento/brute-force
       externo -> medio. -->
  <rule id="100003" level="7">
    <if_sid>5710</if_sid>
    <srcip negate="yes">203.0.113.0/24|203.0.113.0/24</srcip>
    <description>SSH: usuario inexistente a partir de IP fora das faixas institucionais ACME-LAB</description>
    <group>invalid_login,recon,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- SSH: volume / repeticao da mesma origem                       -->
  <!-- Principio: volume da mesma origem e significativo.            -->
  <!-- ============================================================ -->

  <!-- Brute force externo: encadeia sobre 5763 (brute force nativo)
       quando a origem esta fora das faixas BR. Eleva para critico
       porque combina volume + geografia anomala. -->
  <rule id="100004" level="13">
    <if_sid>5763</if_sid>
    <srcip negate="yes">203.0.113.0/24|203.0.113.0/24</srcip>
    <description>SSH: brute force a partir de IP externo nao-institucional</description>
    <group>authentication_failures,bruteforce,</group>
  </rule>

  <!-- Sucesso apos serie de falhas do mesmo IP externo: indica
       comprometimento provavel de credencial. 5 falhas (100002) em
       5 min do mesmo srcip, seguidas de login OK ja seria capturado
       por 100001; aqui correlacionamos falhas->sucesso explicitas. -->
  <!-- Threshold: 5 falhas em 300s do mesmo srcip e suficiente para
       caracterizar tentativa ativa; janela curta evita falso
       positivo de usuarios trocando senha. -->
  <rule id="100005" level="12" frequency="5" timeframe="300">
    <if_matched_sid>100002</if_matched_sid>
    <same_srcip/>
    <description>SSH: multiplas falhas de autenticacao do mesmo IP externo nao-institucional</description>
    <group>authentication_failures,bruteforce,</group>
  </rule>

  <!-- Password spraying: mesmo IP externo tentando varios usuarios.
       Threshold: 8 tentativas de usuarios inexistentes em 600s do
       mesmo srcip. Janela maior porque spraying e mais lento que
       brute force tradicional. -->
  <rule id="100006" level="12" frequency="8" timeframe="600">
    <if_matched_sid>100003</if_matched_sid>
    <same_srcip/>
    <description>SSH: password spraying / enumeracao de usuarios a partir de IP externo</description>
    <group>recon,bruteforce,</group>
  </rule>

  <!-- Ataque distribuido: muitos IPs externos diferentes falhando
       sobre o mesmo host num periodo curto. Threshold: 10 falhas
       em 600s com srcip distintos -> indica botnet/ataque
       coordenado. -->
  <rule id="100007" level="11" frequency="10" timeframe="600">
    <if_matched_sid>100002</if_matched_sid>
    <different_srcip/>
    <description>SSH: ataque distribuido - multiplas falhas de IPs externos distintos</description>
    <group>authentication_failures,bruteforce,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- SSH: tentativas contra root                                   -->
  <!-- Conta root nao deve receber login SSH; tentativas ja sao      -->
  <!-- sinal forte mesmo da faixa interna.                           -->
  <!-- ============================================================ -->

  <!-- Tentativa de autenticacao SSH como root de origem externa:
       combinacao de conta privilegiada + geografia anomala. -->
  <rule id="100008" level="10">
    <if_sid>5710,5716,5760</if_sid>
    <dstuser>root</dstuser>
    <srcip negate="yes">203.0.113.0/24|203.0.113.0/24</srcip>
    <description>SSH: tentativa de login como root a partir de IP externo nao-institucional</description>
    <group>invalid_login,attack,</group>
  </rule>

  <!-- Login SSH bem-sucedido como root (de qualquer origem): contraria
       boa pratica; deve sempre ser via sudo/su. -->
  <rule id="100009" level="13">
    <if_sid>5715</if_sid>
    <dstuser>root</dstuser>
    <description>SSH: login direto como root bem-sucedido (impacto efetivo, contraria politica)</description>
    <group>authentication_success,intrusion,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- Escalada de privilegio (sudo / su)                            -->
  <!-- ============================================================ -->

  <!-- Falhas repetidas de su: usuario tentando virar root sem senha
       correta. Threshold: 3 falhas em 300s do mesmo usuario. -->
  <rule id="100010" level="11" frequency="3" timeframe="300">
    <if_matched_sid>5302</if_matched_sid>
    <same_user/>
    <description>su: multiplas falhas do mesmo usuario tentando virar root</description>
    <group>authentication_failures,privilege_escalation,</group>
  </rule>

  <!-- Sudo bem-sucedido (5402) por usuario cuja sessao SSH veio de
       IP externo (correlacao via 100001). Impacto efetivo de
       privilegio + origem anomala -> critico. -->
  <rule id="100011" level="14" frequency="1" timeframe="3600">
    <if_matched_sid>5402</if_matched_sid>
    <same_user/>
    <description>sudo para root executado por usuario cuja sessao SSH veio de IP externo</description>
    <group>privilege_escalation,intrusion,</group>
  </rule>

  <!-- Multiplas falhas de sudo (5404 ja existe a level 10); aqui
       elevamos quando o mesmo usuario insiste alem do limiar nativo
       num espaco curto -> indica tentativa ativa de escalada. -->
  <rule id="100012" level="12" frequency="2" timeframe="600">
    <if_matched_sid>5404</if_matched_sid>
    <same_user/>
    <description>sudo: usuario persiste com multiplas tentativas falhas de escalada</description>
    <group>privilege_escalation,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- Eventos criticos do sistema                                   -->
  <!-- ============================================================ -->

  <!-- Login bem-sucedido de usuario de sistema (40101 nativo lvl 12)
       a partir de IP externo: contas de sistema nao devem logar
       remotamente -> critico. -->
  <rule id="100013" level="15">
    <if_sid>40101</if_sid>
    <srcip negate="yes">203.0.113.0/24|203.0.113.0/24</srcip>
    <description>Conta de sistema logada com sucesso a partir de IP externo nao-institucional</description>
    <group>system_account,intrusion,</group>
  </rule>

  <!-- illegal root login (2504 nativo lvl 9) vindo de fora das
       faixas BR institucionais -> eleva para critico. -->
  <rule id="100014" level="13">
    <if_sid>2504</if_sid>
    <srcip negate="yes">203.0.113.0/24|203.0.113.0/24</srcip>
    <description>syslog: illegal root login a partir de IP externo nao-institucional</description>
    <group>attack,intrusion,</group>
  </rule>

  <!-- Persistencia do mesmo IP externo: brute force seguido por
       login bem-sucedido (mesmo srcip) -> credencial comprometida.
       Janela de 1800s cobre ataque + sucesso tipico. -->
  <rule id="100015" level="15" frequency="1" timeframe="1800">
    <if_sid>5715</if_sid>
    <if_matched_sid>100005</if_matched_sid>
    <same_srcip/>
    <srcip negate="yes">203.0.113.0/24|203.0.113.0/24</srcip>
    <description>SSH: login bem-sucedido apos brute force do mesmo IP externo - provavel comprometimento</description>
    <group>authentication_success,intrusion,bruteforce,</group>
  </rule>

</group>
